class Board {
    field Array grid;

    constructor Board new() {
        var int i;
        let grid = Array.new(240); 
        let i = 0;
        while (i < 240) {
            let grid[i] = 0; 
            let i = i + 1;
        }
        return this;
    }

    method boolean isOccupied(int c, int r) {
        if (c < 0) { return true; }  
        if (c > 9) { return true; }  
        if (r > 23) { return true; } 
        if (grid[(r * 10) + c] = 1) { return true; } 
        return false;
    }

    method void occupy(int c, int r) {
        let grid[(r * 10) + c] = 1;
        return;
    }

    // בודק ומוחק שורות מלאות. מחזיר את מספר השורות שנמחקו.
    method int clearLines() {
        var int r, c, linesCleared, rMove, cMove;
        var boolean isFull;
        
        let linesCleared = 0;
        let r = 23; // מתחילים לסרוק מהשורה התחתונה ביותר כלפי מעלה
        
        while (r > -1) {
            let isFull = true;
            let c = 0;
            while (c < 10) {
                if (grid[(r * 10) + c] = 0) {
                    let isFull = false;
                }
                let c = c + 1;
            }
            
            if (isFull) {
                let linesCleared = linesCleared + 1;
                
                // מורידים את כל השורות שמעל למטה בבלוק אחד
                let rMove = r;
                while (rMove > 0) {
                    let cMove = 0;
                    while (cMove < 10) {
                        let grid[(rMove * 10) + cMove] = grid[((rMove - 1) * 10) + cMove];
                        let cMove = cMove + 1;
                    }
                    let rMove = rMove - 1;
                }
                
                // מאפסים את השורה העליונה ביותר (כי הכל ירד למטה)
                let cMove = 0;
                while (cMove < 10) {
                    let grid[cMove] = 0;
                    let cMove = cMove + 1;
                }
                
                // נשארים באותה שורה כדי לבדוק אותה שוב (כי הרגע ירדה אליה שורה חדשה מלמעלה)
            } else {
                let r = r - 1; 
            }
        }
        
        // אם נמחקו שורות, מציירים את הלוח מחדש
        if (linesCleared > 0) {
            do redraw();
        }
        
        return linesCleared;
    }

    // מצייר מחדש את כל הקוביות שעל הלוח
    method void redraw() {
        var int r, c, screenX, screenY;
        
        // מחיקת כל השטח הפנימי של הלוח במסך (צבע לבן)
        do Screen.setColor(false);
        do Screen.drawRectangle(200, 10, 299, 249);
        
        // ציור מחדש של הקוביות שנותרו
        do Screen.setColor(true);
        let r = 0;
        while (r < 24) {
            let c = 0;
            while (c < 10) {
                if (grid[(r * 10) + c] = 1) {
                    let screenX = 200 + (c * 10);
                    let screenY = 10 + (r * 10);
                    do Screen.drawRectangle(screenX, screenY, screenX + 9, screenY + 9);
                }
                let c = c + 1;
            }
            let r = r + 1;
        }
        return;
    }

    method void dispose() {
        do grid.dispose();
        do Memory.deAlloc(this);
        return;
    }
}